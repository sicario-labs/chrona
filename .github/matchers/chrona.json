{
  "problemMatcher": [
    {
      "owner": "chrona",
      "pattern": [
        {
          "regexp": "^(.+\\.mdx?)$",
          "file": 1
        },
        {
          "regexp": "^\\s+[✖⚠]\\s+(DOC-\\d+)\\s+(?:L(\\d+))?\\s+(.+)$",
          "code": 1,
          "line": 2,
          "message": 3,
          "loop": true
        }
      ]
    }
  ]
}
