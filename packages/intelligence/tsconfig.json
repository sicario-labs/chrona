{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@chrona/engine": ["../engine/src/index.ts"],
      "@chrona/graph": ["../graph/src/index.ts"]
    },
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "module": "ESNext",
    "target": "ES2020"
  },
  "exclude": ["node_modules", "eslint.config.mjs", "dist"]
}
