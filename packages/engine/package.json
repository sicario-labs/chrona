{
  "name": "@chrona-engine/engine",
  "version": "0.3.0",
  "description": "Repository Intelligence Engine for Chrona. Indexes every exported symbol across a project and resolves cross-file references.",
  "keywords": [
    "Docs",
    "chrona",
    "engine",
    "index"
  ],
  "homepage": "https://chrona.dev",
  "license": "MIT",
  "author": "Emmanuel Enyi",
  "repository": "github:sicario-labs/chrona",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@oxc-project/types": "0.144.0",
    "oxc-parser": "0.144.0",
    "tinyexec": "^1.3.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
