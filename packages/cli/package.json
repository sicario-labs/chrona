{
  "name": "@chrona/cli",
  "version": "1.4.1",
  "description": "The CLI tool for Chrona",
  "keywords": [
    "Docs",
    "Chrona"
  ],
  "homepage": "https://chrona.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:chrona/chrona",
  "bin": {
